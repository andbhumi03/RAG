# Server Port (assigned automatically by cloud hosts like Render/Railway/Heroku)
PORT=5000

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Groq API Key & Model Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# JWT Secret for User Authentication (Use a long, cryptographically random string)
JWT_SECRET=your_production_jwt_secret_key_change_this_in_production

# Optional: Minimum similarity score threshold for RAG retrieval (0.0 to 1.0)
RAG_MIN_RELEVANCE_SCORE=0.20

# Optional: Allowed Frontend Origin for CORS (e.g., https://your-frontend.vercel.app)
FRONTEND_URL=http://localhost:5173
